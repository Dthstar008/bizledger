NODE_ENV=development
PORT=3000

DB_HOST=localhost
# This machine's local PostgreSQL service listens on 4000, not the default 5432
# (see C:\Program Files\PostgreSQL\18\data\postgresql.conf). Adjust if using
# `docker compose up -d` instead, which exposes the standard 5432.
DB_PORT=4000
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bizledger
# Set DB_SSL=true when pointing at a hosted Postgres that requires TLS, e.g.
# Supabase (Project Settings -> Database for host/port/password; db name is
# usually "postgres"; DB_HOST looks like db.<project-ref>.supabase.co, or use
# the pooler host for IPv4 networks / many concurrent connections).
DB_SSL=false
# Max size of the app's own connection pool (node-postgres defaults to 10,
# which becomes the bottleneck under concurrent load before Postgres does).
# Stay under your Postgres/pooler's own connection limit — Supabase's
# session pooler has a cap shared across everything using it, so this isn't
# "set it as high as possible."
DB_POOL_MAX=20
# How long a connection attempt waits before giving up. Raise this on an
# unreliable network (was 5000ms; too aggressive on a flaky dev hotspot —
# caused real "connection timeout" failures on connections that would have
# succeeded given a bit longer). Lower it in a stable production environment
# to fail fast instead of hanging.
DB_CONNECT_TIMEOUT_MS=10000

# Required in production — the app refuses to start without it rather than
# falling back to a guessable default. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=7d

# Comma-separated allowlist of origins allowed to call this API from a
# browser (e.g. https://app.example.com,https://admin.example.com). Leave
# unset in dev (defaults to permissive). In production, leaving it unset
# defaults to closed — CORS has to be an intentional choice, not an accident.
CORS_ORIGINS=
